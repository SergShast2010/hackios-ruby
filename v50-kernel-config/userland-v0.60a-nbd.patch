-	if (!ok) {
-		printf("  mount %s: %s\n", devpath, strerror(errno));
+	ok = 0;
+	for (int attempt = 1; attempt <= 20; attempt++) {
+		if (mount("apfs", "/flash", MNT_RDONLY, devpath) == 0) {
